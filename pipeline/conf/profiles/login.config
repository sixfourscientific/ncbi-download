
profiles {

        login {

                conda.enabled = true
                conda.useMamba = true

                docker.enabled         = true
                docker.userEmulation   = true 

                }

        }

process {

        withLabel: LOGIN {

                resourceLimits.cpus   = 8
                resourceLimits.memory = 8.GB

                cpus           = { 1    * task.attempt }
                memory         = { 0.5.GB * task.attempt }
                
                }

        }